# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하세요.
# secrets.toml은 .gitignore에 포함되어 있어 깃허브에 절대 올라가지 않습니다.
# 배포 시(Streamlit Community Cloud)에는 이 내용을 앱 설정 화면의 "Secrets" 박스에 그대로 붙여넣으면 됩니다.

GEMINI_API_KEY = "여기에 Google AI Studio에서 발급받은 Gemini API 키를 붙여넣으세요"

DRIVE_FOLDER_ID = "1Xzb7MLEyM0TFwbuKKr0YiGyhpRCz13bc"

# 심의문구 가이드 탭의 상품 목록 시트. 기본값이 이미 코드에 들어있어 보통은 안 넣어도 됨.
# 다른 시트로 바꾸고 싶을 때만 여기에 시트 ID를 넣으세요.
# PRODUCT_SHEET_ID = "1fZXl7wWqHOdToA3KflB8KlYsWfu3AFIaLNvDiEtCeH8"

# Space가 Public이어도 아무나 못 쓰게 막는 팀 공용 비밀번호 (직접 정해서 팀원과 공유)
APP_PASSWORD = "팀에서 정한 비밀번호"

# 서비스 계정 JSON 키 파일의 "내용 전체"를 아래처럼 TOML 테이블로 붙여넣습니다.
# (JSON 파일을 열어서 각 항목을 그대로 옮기면 됩니다)
[gcp_service_account]
type = "service_account"
project_id = "여기에 project_id"
private_key_id = "여기에 private_key_id"
private_key = "여기에 private_key (-----BEGIN PRIVATE KEY----- 로 시작하는 값 전체)"
client_email = "여기에 client_email (svc-xxx@xxx.iam.gserviceaccount.com)"
client_id = "여기에 client_id"
token_uri = "https://oauth2.googleapis.com/token"
